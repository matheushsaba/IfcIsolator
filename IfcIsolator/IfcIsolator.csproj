<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DependencyBundleDir>$(MSBuildProjectDirectory)\..\artifacts\IfcIsolatorDependencies\AnyCPU\$(Configuration)\$(TargetFramework)\</DependencyBundleDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xbim.Essentials" Version="6.0.587" />
  </ItemGroup>

  <Target Name="CopyAnyCpuDependencyBundle" AfterTargets="Build">
    <MakeDir Directories="$(DependencyBundleDir)" />
    <ItemGroup>
      <DependencyBundleFiles Include="$(OutputPath)*.dll;$(OutputPath)*.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DependencyBundleFiles)" DestinationFolder="$(DependencyBundleDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
